# Copie para .env local ou configure na Vercel (Environment Variables).
#
# Esta lista é a CHECKLIST DE RESTAURAÇÃO: se um dia precisar subir o projeto do
# zero (ou trocar de provedor), é tudo que precisa existir para o sistema voltar
# a funcionar sozinho. Ao adicionar variável nova no código, acrescente aqui.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Opcional: grava pedidos no painel (Dashboard > Pedidos). Project Settings > API > service_role
# Nunca exponha no frontend. Também é obrigatória para o painel do admin (/admin).
SUPABASE_SERVICE_ROLE_KEY=

# Painel do admin (dono do SaaS): e-mails autorizados a acessar /admin.
# Separe por vírgula para mais de um. Nunca use NEXT_PUBLIC_ aqui.
ADMIN_EMAILS=

# --- App --------------------------------------------------------------------
# URL pública do app, SEM barra no final. A Evolution precisa ALCANÇAR essa URL
# pelo webhook, e os crons a usam para montar o link da loja (não há request no
# cron, então ele não consegue ler o host sozinho).
# Em dev: use um túnel (cloudflared/ngrok) e cole a URL https dele aqui.
APP_BASE_URL=https://seu-app.vercel.app

# --- WhatsApp (Evolution API) -----------------------------------------------
# Base da sua Evolution, SEM barra no final.
EVOLUTION_API_URL=https://evolution.seudominio.com
# A apikey GLOBAL da Evolution (a env AUTHENTICATION_API_KEY de quando você a
# subiu). Trocou de servidor? Esta MUDA junto — a antiga responde 401.
EVOLUTION_API_KEY=

# ⚠️ Na Evolution, WEBHOOK_GLOBAL_ENABLED tem que ficar FALSE. Em modo global ela
# ignora o webhook por instância e o multi-tenant quebra (todas as lojas cairiam
# no mesmo endpoint sem dá para saber de quem é a mensagem).

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys (começa com sk-...)
OPENAI_API_KEY=

# Opcional — modelo do ATENDIMENTO (é o único que segue os marcadores e emite o
# bloco [[PEDIDO]]; errar ali é venda que não entra no painel). Vazio = gpt-4.1-mini.
OPENAI_MODEL=
# Opcional — modelo das tarefas simples (follow-up, pós-venda, carrinho abandonado
# e descrição de foto). Vazio = gpt-4o-mini. Os defaults NÃO se cruzam de propósito:
# definir só OPENAI_MODEL não arrasta os crons junto.
OPENAI_MODEL_BASIC=

# --- Crons (n8n) ------------------------------------------------------------
# Segredo que protege /api/whatsapp/debounce e /api/whatsapp/followups. Sem ele
# as rotas recusam TUDO (inclusive o cron), e a IA para de responder.
# Os workflows prontos estão em n8n/ — veja n8n/README.md.
CRON_SECRET=

# --- Mercado Pago (SUA conta) -----------------------------------------------
# São DOIS tokens porque cada aplicação do MP tem um produto só: um app de
# Checkout Pro responde UNAUTHORIZED em /preapproval.
# Só servidor; use TEST-... para testar.
# App "Checkout Pro" -> recarga de créditos da IA (/dashboard/creditos)
MP_ACCESS_TOKEN=
# App "Assinaturas" -> mensalidade automática do SaaS (/dashboard/planos)
MP_SUBSCRIPTION_ACCESS_TOKEN=

# --- Câmbio do painel admin (opcional) --------------------------------------
# O custo da OpenAI em R$ usa a cotação do dia (AwesomeAPI) + spread. Só mexa
# se quiser fixar valores — ver "Custo real em R$ por loja" no CLAUDE.md.
# AI_USD_BRL=5.50
# AI_USD_SPREAD=1.07
